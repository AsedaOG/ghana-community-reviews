# ── Core ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ── Database (omit for local SQLite) ─────────────────────────────────────────
# DATABASE_URL=postgres://user:password@localhost:5432/gcr

# ── Email (verification links). Default prints emails to the terminal. ───────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# ── Payments: Paystack (cards + MTN MoMo / Telecel Cash / AT Money) ──────────
# Leave empty for sandbox mode (payments simulated locally, everything
# activates immediately). Add live/test keys from dashboard.paystack.com to
# switch the same endpoints to real charges — no code changes needed.
# Then set the webhook URL in the Paystack dashboard to:
#   https://<your-api-host>/api/billing/webhook/paystack/
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CURRENCY=GHS

# ── Media storage: Cloudflare R2 / AWS S3 (defaults to local disk) ───────────
# USE_S3=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=   # R2 endpoint, omit for AWS S3
